@page "/login"
@using BlazorAssiment.Services
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>تسجيل الدخول</PageTitle>

<div class="container mt-5" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <h2 class="fw-bold text-primary">
                            <i class="bi bi-person-circle ms-2"></i>
                            تسجيل الدخول
                        </h2>
                        <p class="text-muted">مرحبًا! الرجاء تسجيل الدخول للمتابعة</p>
                    </div>

                    <EditForm Model="@loginModel" OnValidSubmit="@HandleLogin">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label for="username" class="form-label fw-semibold">
                                <i class="bi bi-person ms-1"></i>
                                اسم المستخدم
                            </label>
                            <InputText id="username"
                                       class="form-control form-control-lg"
                                       @bind-Value="loginModel.Username"
                                       placeholder="أدخل اسم المستخدم"
                                       disabled="@isLoading" />
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label fw-semibold">
                                <i class="bi bi-lock ms-1"></i>
                                كلمة المرور
                            </label>
                            <InputText id="password"
                                       type="password"
                                       class="form-control form-control-lg"
                                       @bind-Value="loginModel.Password"
                                       placeholder="أدخل كلمة المرور"
                                       disabled="@isLoading" />
                        </div>

                        @if (showOtpField)
                        {
                            <div class="mb-3 animate-fade-in">
                                <label for="otp" class="form-label fw-semibold">
                                    <i class="bi bi-shield-check ms-1"></i>
                                    رمز التحقق (OTP)
                                </label>
                                <InputText id="otp"
                                           class="form-control form-control-lg"
                                           @bind-Value="loginModel.Otp"
                                           placeholder="أدخل رمز التحقق"
                                           disabled="@isLoading" />
                                <small class="text-muted">
                                    <i class="bi bi-info-circle ms-1"></i>
                                    استخدم رمز الاختبار: 7890
                                </small>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(message))
                        {
                            <div class="alert @(isSuccess ? "alert-success" : "alert-danger") animate-fade-in" role="alert">
                                <i class="bi @(isSuccess ? "bi-check-circle" : "bi-exclamation-triangle") ms-2"></i>
                                @message
                            </div>
                        }

                        <div class="d-grid gap-2 mb-3">
                            <button type="submit" class="btn btn-primary btn-lg" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm ms-2" role="status" aria-hidden="true"></span>
                                    <span>جارٍ التحقق...</span>
                                }
                                else
                                {
                                    <i class="bi bi-box-arrow-in-right ms-2"></i>
                                    <span>تسجيل الدخول</span>
                                }
                            </button>
                        </div>
                    </EditForm>

                    <div class="mt-4 p-3 bg-light rounded text-center">
                        <p class="fw-bold text-muted mb-2">حسابات الاختبار:</p>
                        <small class="text-muted d-block">
                            <strong>بدون OTP:</strong> john / 123<br />
                            <strong>مع OTP:</strong> jane / 456 (رمز OTP: 7890)<br />
                            <strong>غير مفعل:</strong> inactive / 000
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private bool showOtpField = false;
    private bool isLoading = false;
    private string message = string.Empty;
    private bool isSuccess = false;

    private class LoginModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string Otp { get; set; } = string.Empty;
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        message = string.Empty;
        StateHasChanged();

        var result = await AuthService.LoginAsync(
            loginModel.Username,
            loginModel.Password,
            showOtpField ? loginModel.Otp : null);

        isLoading = false;

        if (result.success)
        {
            isSuccess = true;
            message = result.message;
            StateHasChanged();
            await Task.Delay(1000);
            NavigationManager.NavigateTo("/home");
        }
        else if (result.requiresOtp)
        {
            await AuthService.SavePendingUserAsync(loginModel.Username);
            NavigationManager.NavigateTo($"/otp?username={loginModel.Username}");
        }
        else
        {
            isSuccess = false;
            message = result.message;
            showOtpField = false;
            loginModel.Otp = string.Empty;
        }

        StateHasChanged();
    }
}

<style>
    .animate-fade-in {
        animation: fadeIn 0.5s ease-in;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .card {
        border-radius: 15px;
    }

    .btn-primary {
        border-radius: 10px;
        font-weight: 600;
    }

    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }
</style>
