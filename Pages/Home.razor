@page "/home"
@using BlazorAssiment.Services
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>الصفحة الرئيسية</PageTitle>

<div class="container mt-5">
    @if (currentUser != null)
    {
        <div class="row">
            <div class="col-md-8 mx-auto">
                <div class="card shadow-lg border-0">
                    <div class="card-header bg-primary text-white py-4">
                        <h2 class="mb-0 text-center">
                            <i class="bi bi-house-door me-2"></i>
                            مرحبًا بك في الصفحة الرئيسية
                        </h2>
                    </div>
                    <div class="card-body p-5">
                        <div class="text-center mb-4">
                            <div class="user-avatar mb-3">
                                <i class="bi bi-person-circle text-primary" style="font-size: 100px;"></i>
                            </div>
                            <h3 class="fw-bold text-primary">@currentUser.Username</h3>
                            <p class="text-muted">@currentUser.Email</p>
                        </div>

                        <div class="alert alert-success" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            تم تسجيل الدخول بنجاح! 🎉
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="info-card p-3 bg-light rounded">
                                    <p class="mb-1 text-muted small">اسم المستخدم</p>
                                    <p class="mb-0 fw-bold">@currentUser.Username</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-card p-3 bg-light rounded">
                                    <p class="mb-1 text-muted small">البريد الإلكتروني</p>
                                    <p class="mb-0 fw-bold">@currentUser.Email</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-card p-3 bg-light rounded">
                                    <p class="mb-1 text-muted small">حالة OTP</p>
                                    <p class="mb-0 fw-bold">
                                        @if (currentUser.IsOtpEnabled)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-shield-check me-1"></i>مفعل
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="bi bi-shield-x me-1"></i>غير مفعل
                                            </span>
                                        }
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-card p-3 bg-light rounded">
                                    <p class="mb-1 text-muted small">حالة الحساب</p>
                                    <p class="mb-0 fw-bold">
                                        @if (currentUser.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle me-1"></i>نشط
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle me-1"></i>غير نشط
                                            </span>
                                        }
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid">
                            <button class="btn btn-danger btn-lg" @onclick="HandleLogout">
                                <i class="bi bi-box-arrow-right me-2"></i>
                                تسجيل الخروج
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            يجب تسجيل الدخول أولاً
        </div>
    }
</div>

@code {
    private BlazorAssiment.Models.User? currentUser;

    protected override void OnInitialized()
    {
        // التحقق من تسجيل الدخول
        if (!AuthService.IsAuthenticated())
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        currentUser = AuthService.GetCurrentUser();
    }

    private void HandleLogout()
    {
        AuthService.Logout();
        NavigationManager.NavigateTo("/login");
    }
}

<style>
    .info-card {
        transition: transform 0.2s;
    }

        .info-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

    .card {
        border-radius: 15px;
        overflow: hidden;
    }

    .btn-danger {
        border-radius: 10px;
        font-weight: 600;
    }
</style>

