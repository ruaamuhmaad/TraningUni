@page "/payment-success"
@using BlazorAssiment.Models
@using BlazorAssiment.Services
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject MeterStateService StateService

<PageTitle>نجاح الدفع</PageTitle>

<div class="container mt-4" dir="rtl">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <div class="success-icon mb-3 animate-scale">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
            </div>
            <h2 class="fw-bold text-success">
                تمت العملية بنجاح!
            </h2>
            <p class="text-muted">تم إتمام عملية الدفع وشحن العداد بنجاح</p>
        </div>
    </div>

    @if (StateService.CurrentPayment != null && StateService.CurrentPayment.Success)
    {
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="card shadow border-success animate-fade-in">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-receipt ms-2"></i>
                            إيصال الدفع
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-success mb-4">
                            <i class="bi bi-check2-circle ms-2"></i>
                            <strong>مبروك!</strong> تم شحن عدادك بنجاح
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover">
                                <tbody>
                                    <tr>
                                        <th width="35%"><i class="bi bi-person ms-2"></i> اسم العميل</th>
                                        <td>@StateService.CurrentPayment.CustomerName</td>
                                    </tr>
                                    <tr>
                                        <th><i class="bi bi-lightning ms-2"></i> رقم العداد</th>
                                        <td>@StateService.CurrentPayment.MeterNumber</td>
                                    </tr>
                                    <tr>
                                        <th><i class="bi bi-credit-card ms-2"></i> رقم الحساب</th>
                                        <td>@StateService.CurrentPayment.AccountNumber</td>
                                    </tr>
                                    <tr class="table-warning">
                                        <th><i class="bi bi-currency-shekel ms-2"></i> المبلغ المدفوع</th>
                                        <td class="fw-bold text-success fs-5">@StateService.CurrentPayment.AmountPaid.ToString("F2") ₪</td>
                                    </tr>
                                    <tr class="table-info">
                                        <th><i class="bi bi-battery-charging ms-2"></i> الوحدات المضافة</th>
                                        <td class="fw-bold text-primary fs-5">@StateService.CurrentPayment.UnitsAdded.ToString("F2") كيلو واط</td>
                                    </tr>
                                    <tr>
                                        <th><i class="bi bi-file-text ms-2"></i> الرقم المرجعي</th>
                                        <td>@StateService.CurrentPayment.ReferenceNumber</td>
                                    </tr>
                                    <tr>
                                        <th><i class="bi bi-wallet2 ms-2"></i> الحساب المستخدم</th>
                                        <td>@StateService.CurrentPayment.AccountUsed</td>
                                    </tr>
                                    <tr>
                                        <th><i class="bi bi-clock ms-2"></i> التاريخ والوقت</th>
                                        <td>@StateService.CurrentPayment.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Token Display -->
                        <div class="card bg-warning bg-opacity-10 border-warning mt-4">
                            <div class="card-body text-center">
                                <h5 class="card-title text-warning mb-3">
                                    <i class="bi bi-key-fill ms-2"></i>
                                    رمز الشحن (Token)
                                </h5>
                                <div class="token-display p-3 bg-white border border-warning rounded">
                                    <p class="mb-2 text-muted small">استخدم هذا الرمز لشحن العداد</p>
                                    <h3 class="text-primary fw-bold mb-0 user-select-all" style="letter-spacing: 2px;">
                                        @StateService.CurrentPayment.Token
                                    </h3>
                                </div>
                                <small class="text-muted mt-2 d-block">
                                    <i class="bi bi-info-circle ms-1"></i>
                                    احفظ هذا الرمز أو اضغط عليه للنسخ
                                </small>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button class="btn btn-primary btn-lg" @onclick="HandleNewOperation">
                                <i class="bi bi-arrow-clockwise ms-2"></i>
                                عملية جديدة
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="HandleGoHome">
                                <i class="bi bi-house ms-2"></i>
                                العودة للرئيسية
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle ms-2"></i>
            لا توجد بيانات دفع للعرض
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        if (!AuthService.IsAuthenticated())
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        if (StateService.CurrentPayment == null)
        {
            NavigationManager.NavigateTo("/home");
        }
    }

    private void HandleNewOperation()
    {
        StateService.CurrentRequest = null;
        StateService.CurrentResponse = null;
        StateService.CurrentPayment = null;
        NavigationManager.NavigateTo("/home");
    }

    private void HandleGoHome()
    {
        NavigationManager.NavigateTo("/home");
    }
    private void HandleGoToPayment()
    {
        NavigationManager.NavigateTo("/payment-confirmation");
    }
}

<style>
    .animate-fade-in {
        animation: fadeIn 0.6s ease-in;
    }

    .animate-scale {
        animation: scaleUp 0.5s ease-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes scaleUp {
        from {
            transform: scale(0);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .token-display {
        transition: all 0.3s ease;
    }

        .token-display:hover {
            transform: scale(1.02);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

    .user-select-all {
        cursor: pointer;
    }

    .table th {
        background-color: #f8f9fa;
    }

    .animate-fade-in {
        animation: fadeIn 0.5s ease-in;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>