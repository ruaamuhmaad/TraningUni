 @page
@model BlazorAssiment.Pages.ErrorModel

<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Error</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow-lg">
                    <div class="card-body text-center p-5">
                        <h1 class="display-1 text-danger">⚠️</h1>
                        <h2 class="mb-3">Error Occurred</h2>
                        <p class="text-muted">Sorry, an error occurred while processing your request.</p>
                        <a href="/login" class="btn btn-primary mt-3">Return to Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>