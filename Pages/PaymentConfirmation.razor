@page "/payment-confirmation"
@using BlazorAssiment.Models
@using BlazorAssiment.Services
@inject IElectricMeterService MeterService
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject MeterStateService StateService

<PageTitle>تأكيد الدفع</PageTitle>

<div class="container mt-4" dir="rtl">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="fw-bold text-warning">
                    <i class="bi bi-exclamation-circle ms-2"></i>
                    تأكيد الدفع
                </h2>
                <button class="btn btn-outline-secondary" @onclick="HandleGoBack" disabled="@isProcessing">
                    <i class="bi bi-arrow-right ms-2"></i>
                    رجوع
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(processingError))
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle ms-2"></i>
            حدث خطأ أثناء معالجة الدفع: @processingError
        </div>
    }

    @if (StateService.CurrentRequest != null && StateService.CurrentResponse != null)
    {
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow border-warning animate-fade-in">
                    <div class="card-header bg-warning">
                        <h5 class="mb-0">
                            <i class="bi bi-shield-exclamation ms-2"></i>
                            مراجعة بيانات الدفع
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-warning">
                            <i class="bi bi-info-circle ms-2"></i>
                            <strong>تنبيه:</strong> يرجى مراجعة البيانات قبل تأكيد الدفع
                        </div>

                        <div class="table-responsive mb-4">
                            <table class="table table-bordered">
                                <tbody>
                                    <tr>
                                        <th width="40%">اسم العميل</th>
                                        <td>@StateService.CurrentResponse.CustomerName</td>
                                    </tr>
                                    <tr>
                                        <th>رقم العداد</th>
                                        <td>@StateService.CurrentRequest.MeterNo</td>
                                    </tr>
                                    <tr>
                                        <th>رقم الحساب</th>
                                        <td>@StateService.CurrentResponse.AccountNumber</td>
                                    </tr>
                                    <tr class="table-warning">
                                        <th>المبلغ الإجمالي</th>
                                        <td class="fw-bold fs-5">@StateService.CurrentRequest.Amount.ToString("F2") ₪</td>
                                    </tr>
                                    <tr>
                                        <th>التعديلات</th>
                                        <td class="text-danger">@StateService.CurrentResponse.Adjustments.ToString("F2") ₪</td>
                                    </tr>
                                    <tr class="table-success">
                                        <th>مبلغ الشحن الفعلي</th>
                                        <td class="fw-bold text-success">@StateService.CurrentResponse.RechargeAmount.ToString("F2") ₪</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="d-grid gap-2">
                            <button class="btn btn-success btn-lg" @onclick="HandleProcessPayment" disabled="@isProcessing">
                                @if (isProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm ms-2"></span>
                                    <span>جارٍ معالجة الدفع...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check-circle ms-2"></i>
                                    <span>تأكيد الدفع</span>
                                }
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="HandleGoBack" disabled="@isProcessing">
                                <i class="bi bi-x-circle ms-2"></i>
                                إلغاء
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle ms-2"></i>
            لا توجد بيانات للدفع
        </div>
    }
</div>

@code {
    private bool isProcessing = false;
    private string? processingError;

    protected override void OnInitialized()
    {
        if (!AuthService.IsAuthenticated())
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        if (StateService.CurrentRequest == null || StateService.CurrentResponse == null)
        {
           
            NavigationManager.NavigateTo("/home");
            return;
        }
    }

    private async Task HandleProcessPayment()
    {
        
        if (StateService.CurrentRequest == null)
        {
            processingError = "بيانات الطلب غير متوفرة.";
            return;
        }

        isProcessing = true;
        processingError = null;
        StateHasChanged();

        try
        {
            var paymentResponse = await MeterService.ProcessPaymentAsync(StateService.CurrentRequest);
            StateService.CurrentPayment = paymentResponse;

            NavigationManager.NavigateTo("/payment-success");
        }
        catch (Exception ex)
        {
       
            processingError = ex.Message;
            isProcessing = false;
            StateHasChanged();
        }
    }

    private void HandleGoBack()
    {
     
        NavigationManager.NavigateTo("/meter-results");
    }
}

<style>
    .animate-fade-in {
        animation: fadeIn 0.5s ease-in;
    }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: translateY(-10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }</style>
